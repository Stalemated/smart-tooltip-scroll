  "authors": [
    "Stalemated"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/smart-tooltip-scroll",
    "sources": "https://github.com/Stalemated/smart-tooltip-scroll",
    "issues": "https://github.com/Stalemated/smart-tooltip-scroll/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.stalemated.sts.fabric.SmartTooltipScrollFabric"
    ],
    "modmenu": [
      "com.stalemated.sts.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "sts.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
